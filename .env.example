# ─────────────────────────────────────────────────────────────
# SDK Guardian — environment settings
# Copy this file to ".env" and fill in the real values.
# NEVER commit your real ".env" file to GitHub.
# ─────────────────────────────────────────────────────────────

# Bot token: Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Application ID: Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=000000000000000000

# MongoDB connection string (local example shown)
MONGODB_URI=mongodb://127.0.0.1:27017/sdk-guardian

# development or production
NODE_ENV=development

# fatal, error, warn, info, debug or trace
LOG_LEVEL=info

# Which server ID file to use. Use a separate file for the test server,
# for example config/guild.test.json
GUILD_CONFIG_PATH=config/guild.json
